"""Bazel-in-Bazel negative tests: assert that misusing the rules_tofu rules
fails with a stable, user-visible error message.

Each case names a target inside the sub-workspace under
`broken_workspace/cases/<case>/` and a short stderr fragment expected when
the nested Bazel fails on it: `_CASES` drives the target with
`bazel build`, `_RUN_CASES` with `bazel run`. The child workspace packages
are excluded from the parent Bazel via the `--deleted_packages` flag in
`.bazelrc` (the "deleted packages" trick recommended by
rules_bazel_integration_test), so the outer Bazel never analyzes the
intentionally-broken case targets when expanding `//...`.
"""

load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load(
    "@rules_bazel_integration_test//bazel_integration_test:defs.bzl",
    "bazel_integration_test",
    "integration_test_utils",
)
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "assert_bazel_fails",
    srcs = ["assert_bazel_fails.sh"],
)

# The sub-workspace is a single Bazel module, so every case ships the whole
# thing; glob once and share the list.
_WORKSPACE_FILES = integration_test_utils.glob_workspace_files("broken_workspace") + [
    "//:local_repository_files",
]

# Failures raised by the outer Bazel itself — loading, analysis, or an action
# the rules emit. Driven by `bazel build`, the driver's default command.
_CASES = [
    # (case_name, target inside broken_workspace, stderr fragment)
    ("duplicate_vars", "//cases/duplicate_vars:dup", "declared in both"),
    ("duplicate_vars_hcl", "//cases/duplicate_vars:dup_hcl", "declared in both"),
    ("validate_fails", "//cases/validate_fails:bad", "Reference to undeclared input variable"),
    ("missing_provider", "//cases/missing_provider:missing", "Failed to query available provider packages"),
    ("lock_file_smuggled", "//cases/lock_file_smuggled:smuggled", "refusing to validate"),
    ("auto_tfvars_conflict", "//cases/auto_tfvars_conflict:deploy", "collides with the generated"),
    ("external_module_ref", "//cases/external_module_ref:lib", "external Bazel module"),
    ("malformed_var_file", "//cases/malformed_var_file:deploy", "parse:"),
    ("conflicting_providers", "//cases/conflicting_providers:lib", "conflicting versions"),
]

# Failures raised at runtime by the launcher a `tf_deploy` generates: the
# target builds cleanly and the refusal comes from the runner process. These
# also cover the plumbing from BUILD attribute to runner flag, which the
# runner's Go unit tests cannot see.
_RUN_CASES = [
    # (case_name, target inside broken_workspace, stderr fragment)
    ("ephemeral_state_refused", "//cases/ephemeral_state_refused:deploy.apply", "allow_ephemeral_state"),
]

[
    bazel_integration_test(
        name = case_name + "_test",
        timeout = "moderate",
        bazel_binaries = bazel_binaries,
        bazel_version = bazel_binaries.versions.current,
        env = {
            "TARGET": target,
            "EXPECTED_PATTERN": pattern,
        },
        tags = ["exclusive"],
        test_runner = ":assert_bazel_fails",
        workspace_files = _WORKSPACE_FILES,
        workspace_path = "broken_workspace",
    )
    for (case_name, target, pattern) in _CASES
]

[
    bazel_integration_test(
        name = case_name + "_test",
        timeout = "moderate",
        bazel_binaries = bazel_binaries,
        bazel_version = bazel_binaries.versions.current,
        env = {
            "BAZEL_COMMAND": "run",
            "TARGET": target,
            "EXPECTED_PATTERN": pattern,
        },
        tags = ["exclusive"],
        test_runner = ":assert_bazel_fails",
        workspace_files = _WORKSPACE_FILES,
        workspace_path = "broken_workspace",
    )
    for (case_name, target, pattern) in _RUN_CASES
]
